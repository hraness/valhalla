+            .unwrap();
+            assert!(matches!(
+                stream.next().await,
+                Some(TransportEvent::NewAddress { .. })
+            ));
+            let socket = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+            let username = b"0123456789abcdef0123456789abcdef:0123456789abcdef0123456789abcdef";
+            let mut packet = vec![0, 1, 0, 72, 0x21, 0x12, 0xa4, 0x42];
+            packet.extend_from_slice(&[9; 12]);
+            packet.extend_from_slice(&[0, 6, 0, 65]);
+            packet.extend_from_slice(username);
+            packet.extend_from_slice(&[0; 3]);
+            for poll_upgrade in [false, true] {
+                socket.send_to(&packet, stream.listen_addr).await.unwrap();
+                let event = tokio::time::timeout(Duration::from_secs(1), stream.next())
+                    .await
+                    .unwrap()
+                    .unwrap();
+                let mut upgrade = match event {
+                    TransportEvent::Incoming { upgrade, .. } => upgrade,
+                    event => panic!("unexpected {event:?}"),
+                };
+                if poll_upgrade {
+                    // Poll the actual WebRTC upgrade while servicing its real mux,
+                    // then cancel it before an unauthenticated fixture can finish.
+                    let pumping = poll_fn(|cx| {
+                        let _ = stream.udp_mux.poll(cx);
+                        Poll::<()>::Pending
+                    });
+                    let racing = futures::future::select(upgrade.as_mut(), pumping);
+                    assert!(
+                        tokio::time::timeout(Duration::from_millis(40), racing)
+                            .await
+                            .is_err()
+                    );
+                }
+                drop(upgrade);
+                let pumping = poll_fn(|cx| {
+                    let _ = stream.udp_mux.poll(cx);
+                    Poll::<()>::Pending
+                });
+                assert!(
+                    tokio::time::timeout(Duration::from_millis(20), pumping)
+                        .await
+                        .is_err()
+                );
+                // Reusing the exact source and ufrag on the next iteration proves
+                // the real Incoming upgrade did not strand its reservation.
+            }
+            socket.send_to(&packet, stream.listen_addr).await.unwrap();
+            assert!(matches!(
+                tokio::time::timeout(Duration::from_secs(1), stream.next())
+                    .await
+                    .unwrap(),
+                Some(TransportEvent::Incoming { .. })
+            ));
+        })
+        .await
+        .unwrap();
+    }
+}
