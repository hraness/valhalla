 const RECEIVE_MTU: usize = 8192;
+const MAX_PENDING: usize = 32;
+const MAX_CONNS: usize = 32;
+const POLL_BUDGET: usize = 32;
+const RESERVATION_TTL: Duration = Duration::from_secs(10);
+const PENDING: u8 = 0;
+const PROMOTED: u8 = 1;
+const CANCELLED: u8 = 2;
+
+#[derive(Debug)]
+struct Admission {
+    addr: SocketAddr,
+    ufrag: String,
+    deadline: Instant,
+    status: AtomicU8,
+    waker: Arc<AtomicWaker>,
+}
+
+impl Admission {
+    fn valid(&self) -> bool {
+        match self.status.load(Ordering::Acquire) {
+            PROMOTED => true,
+            PENDING if Instant::now() < self.deadline => true,
+            _ => false,
+        }
+    }
+    fn cancel_pending(&self) -> u8 {
+        self.status
+            .compare_exchange(PENDING, CANCELLED, Ordering::AcqRel, Ordering::Acquire)
+            .unwrap_or_else(|status| status)
+    }
+    fn promote(&self) -> bool {
+        if Instant::now() >= self.deadline {
+            return false;
+        }
+        self.status
+            .compare_exchange(PENDING, PROMOTED, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+    }
+}
+
+/// Only this owner can keep an unaccepted incoming reservation alive. Scoped
+/// ICE handles may share its identity, but cannot keep a cancelled offer alive.
+#[derive(Debug)]
+pub(crate) struct Reservation {
+    state: Arc<Admission>,
+}
+impl Reservation {
+    pub(crate) fn valid(&self) -> bool {
+        self.state.valid()
+    }
+    pub(crate) fn remaining(&self) -> Duration {
+        self.state
+            .deadline
+            .saturating_duration_since(Instant::now())
+    }
+    pub(crate) fn promote(&self) -> bool {
+        self.state.promote()
+    }
+}
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        let _ = self.state.status.compare_exchange(
+            PENDING,
+            CANCELLED,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        );
+        self.state.waker.wake();
+    }
+}
 
