+impl WriterPermit {
+    fn valid(&self, target: SocketAddr) -> bool {
+        self.live.load(Ordering::Acquire)
+            && self
+                .admission
+                .as_ref()
+                .is_none_or(|admission| admission.valid() && admission.addr == target)
+    }
+}
