+            Poll::Ready(UDPMuxEvent::NewAddr(_)) => panic!("unexpected incoming offer"),
+            Poll::Pending => Poll::<()>::Pending,
+        });
+        futures::pin_mut!(operation, pumping);
+        match tokio::time::timeout(
+            Duration::from_secs(1),
+            futures::future::select(operation, pumping),
