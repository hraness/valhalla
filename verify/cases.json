    {
      "id": "host-recovery",
      "module": "verify/host-recovery/HostRecovery.tla",
      "claim": "Interrupted sealed-host maintenance preserves restart evidence and admits only a complete sealed snapshot.",
      "status": "implementation-correspondence",
      "bounds": "Two selected files, old/new versions, one replacement, config/file backups and at most two process interruptions or power losses. Uncertain case corrupts a retained rollback backup.",
      "assumptions": [
        "Successful individual rewrite is atomic and durable; visible marker unlink and directory durability are distinct.",
        "One cooperative maintenance owner. No physical filesystem, fsync, cryptographic or APFS proof. Corrupt rollback evidence requires preserved refusal."
      ],
      "sources": [
