{
  "schema_version": 1,
  "suites": [
    {
      "id": "private-delivery",
      "module": "verify/private-delivery/PrivateDelivery.tla",
      "claim": "Fetched retryable traffic retains custody across restart; exact replay does not repeat its application effect.",
      "status": "implementation-correspondence",
      "bounds": "Three item identities; normal has two clients, capacity three and one crash each; capacity case has one client and capacity one.",
      "assumptions": [
        "Atomic item/progress publication and exact item identities abstract storage and cryptography.",
        "Conditional liveness assumes valid authority, successful storage/transport, fair scheduling and sufficient capacity. Capacity case checks safety only."
      ],
      "sources": [
        {
          "path": "browser/src/private/delivery_engine.rs",
          "symbols": [
            "Engine::inbound",
            "Engine::retry_deferred",
            "Engine::receive"
          ],
          "role": "production"
        },
        {
          "path": "browser/tests/private_delivery_engine.rs",
          "symbols": [
            "future_message_before_control_survives_restart_and_is_applied_once",
            "deferred_ciphertext_and_cursor_publish_atomically_across_uncertain_completion"
          ],
          "role": "regression"
        }
      ],
      "cases": [
        {
          "id": "normal",
          "config": "verify/private-delivery/normal.cfg",
          "expected": {
            "kind": "success"
          }
        },
        {
          "id": "capacity",
          "config": "verify/private-delivery/capacity.cfg",
          "expected": {
            "kind": "success"
          }
        },
        {
          "id": "mutant-skip",
          "config": "verify/private-delivery/mutant-skip.cfg",
          "expected": {
            "kind": "invariant",
            "property": "NoLostWork"
          },
          "historical_trace": "verify/private-delivery/counterexamples/mutant-skip.json"
        },
        {
          "id": "mutant-crash",
          "config": "verify/private-delivery/mutant-crash.cfg",
          "expected": {
            "kind": "invariant",
            "property": "NoLostWork"
          },
          "historical_trace": "verify/private-delivery/counterexamples/mutant-crash.json"
        },
        {
          "id": "mutant-duplicate",
          "config": "verify/private-delivery/mutant-duplicate.cfg",
          "expected": {
            "kind": "invariant",
            "property": "ExactlyOnce"
          },
          "historical_trace": "verify/private-delivery/counterexamples/mutant-duplicate.json"
        }
      ]
    },
