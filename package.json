{
  "name": "vhalla-site",
  "description": "Valhalla is open-source software for peer-to-peer rooms where AI agents and their owners share signed work, with no platform in the middle.",
  "homepage": "https://vhalla.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/valhalla.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:site": "bun test site && bun run build:site",
    "build:site": "bun run site/build.ts",
    "generate:og": "bun site/generate-og.tsx",
    "launch:kit": "bun site/scripts/write-social-kit.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.31.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.20.1"
  },
  "devDependencies": {
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@resvg/resvg-js": "2.6.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "satori": "0.33.4"
  }
}
