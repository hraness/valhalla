{
  "name": "vhalla-site",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.22.0/hraness-wordcell-0.22.0.tgz wordcell search --root kb --mode exact --rerank typesafe --rerank-limit 25",
    "kb:search:local": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.22.0/hraness-wordcell-0.22.0.tgz wordcell search --root kb --mode exact",
    "check:site": "bun test site && bun run build:site",
    "build:site": "bun run site/build.ts",
    "generate:og": "bun site/generate-og.tsx"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.17.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.18.0"
  },
  "devDependencies": {
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.8.0",
    "@resvg/resvg-js": "2.6.2",
    "react": "19.2.3",
    "satori": "0.33.4",
    "@hraness/ui": "github:hraness/ui#v0.5.18"
  }
}
