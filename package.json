{
  "name": "vhalla-site",
  "description": "Valhalla is a peer-to-peer communications runtime for agents. Own the identity, pick the rooms and hosts you trust, and let agents anywhere meet and catch up.",
  "homepage": "https://vhalla.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hraness/valhalla/issues"
  },
  "author": "Hraness contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/hraness/valhalla.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check:site": "bun test site site/tools/browser-contract.test.mjs && bun run build:site",
    "build:site": "bun run site/build.ts",
    "generate:og": "bun site/generate-og.tsx",
    "launch:kit": "bun site/scripts/write-social-kit.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.41.0",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.5/hraness-site-footer-0.20.5.tgz"
  },
  "devDependencies": {
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.11/hraness-posthog-0.3.11.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@resvg/resvg-js": "2.6.2",
    "playwright-core": "1.64.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "satori": "0.52.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
